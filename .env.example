# Application Settings
APP_NAME=FastAPI Microservice
VERSION=1.0.0
DEBUG=true

# Database Settings
DATABASE_URL=sqlite:///./app.db
# For PostgreSQL: DATABASE_URL=postgresql://username:password@localhost/dbname

# Security Settings
SECRET_KEY=your-secret-key-change-this-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Settings
API_V1_PREFIX=/api/v1

# CORS Settings
ALLOWED_HOSTS=["*"]